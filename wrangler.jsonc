{
  "name": "drip-select",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker se pokreće samo za ove adrese; sve ostalo servira Cloudflare direktno iz public/
    "run_worker_first": ["/api/*", "/admin/config.yml"]
  },
  // Javne vrednosti. Tajne (GITHUB_TOKEN, RESEND_API_KEY, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, MAIL_TO)
  // se unose u Cloudflare-u kao Secret i NE idu ovde.
  "vars": {
    "GH_OWNER": "ilicbogdan36-a11y",
    "GH_REPO": "Drip-Select",
    "ALLOWED_USERS": "ilicbogdan36-a11y"
  },
  "observability": { "enabled": true }
}
